MultiSelectionComboBox {
    border: 1px solid rgba(255, 255, 255, 0.053);
    border-radius: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.03);
}

MultiSelectionComboBox[isHover=true] {
    background-color: rgba(255, 255, 255, 0.05);
}

MultiSelectionComboBox[isPressed=true] {
    background-color: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.053);
}

MultiSelectionComboBox:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.053);
    border-top: 1px solid rgba(255, 255, 255, 0.053);
}

MultiSelectionComboBox QLabel[isPlaceholderText=true] {
    color: rgba(255, 255, 255, 0.6063);
    background: transparent;
}

/* QScrollArea viewport does not respond to ID selectors;
   target QScrollArea by type and tokenContainer by ID */
MultiSelectionComboBox QScrollArea,
MultiSelectionComboBox QScrollArea > QWidget > QWidget,
#tokenContainer {
    background: transparent;
    border: none;
}

MultiSelectionToken {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

MultiSelectionToken QLabel {
    color: white;
    background: transparent;
}

MultiSelectionToken QToolButton {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    border-radius: 4px;
}

MultiSelectionToken QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

#comboListWidget::item {
    margin-left: 4px;
    margin-right: 0px;
    padding-left: 0px;
    padding-right: 4px;
}
