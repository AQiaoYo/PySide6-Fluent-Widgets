/* AgentChatView 容器自身透明，背景由父容器提供 */
AgentChatView,
AgentChatView > QWidget,
AgentChatView #chatScrollContainer {
    background: transparent;
    border: none;
}

/* 用户消息气泡：偏冷蓝调，暗色下用半透明 */
ChatBubble[role="user"] #bubbleBody {
    background-color: rgba(96, 165, 250, 0.16);
    border-radius: 8px;
}

/* Agent 消息：平铺式, 无气泡背景 (markdown 直接铺) */
ChatBubble[role="agent"] #bubbleBody {
    background: transparent;
    border: none;
    border-radius: 0px;
}

ChatBubble[role="system"] #bubbleBody {
    background: transparent;
    border-radius: 0px;
}

/* 平铺模式: 发送者名 (加粗) 颜色与正文同 */
ChatBubble #senderName {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
}

/* 平铺模式: 副标题 (供应商等) 弱化色 */
ChatBubble #senderSubtitle {
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

MarkdownView,
MarkdownView > QWidget {
    background: transparent;
    border: none;
}

MarkdownView QTextBrowser {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    selection-background-color: rgba(96, 165, 250, 0.4);
}

/* 代码块卡片: 整体统一暗底, 卡片边框 + 极淡分割线划分 header/body */
CodeBlock {
    background-color: rgba(0, 0, 0, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
}

CodeBlock #codeHeader {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

CodeBlock #codeLanguage {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
    padding-left: 2px;
    font-weight: 400;
}

CodeBlock QPlainTextEdit {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    selection-background-color: rgba(96, 165, 250, 0.3);
}

/* CodeBlock 内部滚动条由 SmoothScrollDelegate 在 Python 侧配置 (groove
   alpha=0 + 隐藏箭头按钮), 只保留 3px handle 细线. */

/* 底部展开/折叠按钮行 */
CodeBlock #codeExpandRow {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

CodeBlock #codeExpandButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.55);
}

CodeBlock #codeExpandButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.95);
}

ChatBubble #timestampLabel {
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}

ChatBubble #actionBar {
    background: transparent;
    border: none;
}

/* ----------------------------- ThinkingCard ---------------------------- */

ThinkingCard {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

ThinkingCard #thinkingHeader {
    background: transparent;
    border: none;
    border-radius: 8px;
}

ThinkingCard #thinkingHeader:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

ThinkingCard #thinkingTitle {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
    border: none;
    font-weight: 500;
}

ThinkingCard #thinkingContentWrap {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* ----------------------------- ToolCallCard (基类与全部特化子类) ---- */

#toolCallCard {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

#toolCallCard #toolCallHeader {
    background: transparent;
    border: none;
    border-radius: 8px;
}

#toolCallCard #toolCallHeader:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

#toolCallCard #toolCallName {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    border: none;
    font-weight: 600;
}

#toolCallCard #toolCallDuration {
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
    border: none;
}

#toolCallCard #toolCallStatusText {
    color: rgba(248, 81, 73, 0.92);
    background: transparent;
    border: none;
    font-weight: 500;
}

#toolCallCard #toolCallContentWrap {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

#toolCallCard #toolCallSectionLabel {
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
}

/* 审批按钮区 (PENDING_APPROVAL) */
#toolCallCard #toolCallApproval {
    background: transparent;
    border: none;
}

/* ----------------------------- DiffView ----------------------------- */

#diffView {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

#diffLineAdd,
#diffLineRemove,
#diffLineContext,
#diffLineHunk {
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 12px;
    padding: 2px 8px;
    border: none;
    color: rgba(255, 255, 255, 0.85);
}

#diffLineAdd {
    background-color: rgba(63, 185, 80, 0.18);
    color: rgba(165, 230, 175, 1.0);
}

#diffLineRemove {
    background-color: rgba(248, 81, 73, 0.18);
    color: rgba(255, 170, 175, 1.0);
}

#diffLineContext {
    background: transparent;
    color: rgba(255, 255, 255, 0.62);
}

#diffLineHunk {
    background-color: rgba(96, 165, 250, 0.12);
    color: rgba(160, 200, 255, 0.92);
    font-weight: 500;
}

/* ----------------------------- FileReadCard ------------------------- */

#toolCallCard #lineRangeLabel {
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
}

/* ----------------------------- BashCard ----------------------------- */

BashCard #bashOutputView {
    background-color: rgb(18, 18, 22);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

BashCard #bashOutputText {
    background: transparent;
    border: none;
    color: rgba(230, 230, 230, 1.0);
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 12px;
}

BashCard #bashExitBadge {
    border: none;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 500;
    font-size: 11px;
    color: white;
}

BashCard #bashExitBadge[ok="true"] {
    background-color: rgba(63, 185, 80, 0.85);
}

BashCard #bashExitBadge[ok="false"] {
    background-color: rgba(248, 81, 73, 0.85);
}

/* ----------------------------- WebSearchCard ------------------------ */

WebSearchCard #webResultList {
    background: transparent;
    border: none;
}

WebSearchCard #webResultRow {
    background: transparent;
    border: none;
}

WebSearchCard #webResultTitle {
    color: rgba(110, 175, 255, 0.95);
    background: transparent;
    border: none;
    font-weight: 600;
}

WebSearchCard #webResultTitle:hover {
    color: rgba(150, 200, 255, 1.0);
    text-decoration: underline;
}

WebSearchCard #webResultUrl {
    color: rgba(110, 200, 130, 0.85);
    background: transparent;
    border: none;
}

WebSearchCard #webResultSnippet {
    color: rgba(255, 255, 255, 0.75);
    background: transparent;
    border: none;
}

/* ----------------------------- GrepSearchCard ----------------------- */

GrepSearchCard #grepHitList {
    background: transparent;
    border: none;
}

/* 一条命中 = 一张独立小卡片. */
GrepSearchCard #grepHitRow {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

GrepSearchCard #grepHitPath {
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 11px;
}

GrepSearchCard #grepHitPreview {
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
    border: none;
    padding: 0;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 12px;
}

/* ----------------------------- GenerationStatusBar ------------------ */

/* 默认: 顶栏式 (浮动在 viewport 顶部, AgentChatView standalone 用法). */
#generationStatusBar {
    background-color: rgba(28, 28, 32, 0.96);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

/* AgentChatPanel 把状态条 reparent 到输入框上方做成 "小卡片",
   与输入框等圆角 (line_edit 5px). */
#chatGenBarCard {
    background-color: rgba(40, 40, 44, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
}

#generationStatusBar #generationStatusText,
#chatGenBarCard #generationStatusText {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    border: none;
}

#generationStatusBar #generationStatusTokens,
#chatGenBarCard #generationStatusTokens {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

#generationStatusBar #generationStatusElapsed,
#chatGenBarCard #generationStatusElapsed {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
}

/* "已停止" 提示行 */
ChatBubble #bubbleStoppedLabel {
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
    border: none;
    font-style: italic;
}

/* USER 气泡内联编辑器 + 版本选页器 (对话分叉) */
#bubbleInlineEditor {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 14px;
}

#bubbleVersionPager {
    background: transparent;
}

#bubbleVersionLabel {
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    font-size: 12px;
}

/* ============================================================
   ChatInputEdit (dark) — Agent 聊天输入框
   ============================================================ */

#chatInputEdit {
    padding: 12px 14px;
    font-size: 15px;
}

/* 圆形发送按钮: 浅色填充 + 深色箭头 */
#chatSendButton {
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    border: none;
}
#chatSendButton:hover {
    background-color: rgba(255, 255, 255, 0.95);
}
#chatSendButton:pressed {
    background-color: rgba(255, 255, 255, 0.7);
}
#chatSendButton:disabled {
    background-color: rgba(255, 255, 255, 0.18);
}

#chatAttachButton {
    background: transparent;
    border-radius: 8px;
    border: none;
}
#chatAttachButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
#chatAttachButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

/* Token 预估指示器 (右下, 发送按钮左侧) — 紧凑文字 + 图标. */
#chatTokenIndicator {
    background: transparent;
}
#chatContextLabel,
#chatTokenCountLabel,
#chatTokenSeparator {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    font-size: 12px;
}
#chatTokenSeparator {
    padding: 0 2px;
    color: rgba(255, 255, 255, 0.3);
}


/* ============================================================
   MessageNav (dark) — 侧边消息导航条
   ============================================================ */

#messageNav {
    background: transparent;
    border: none;
}

/* ============================================================
   SessionRetryCard (dark) — 重试倒计时卡片
   ============================================================ */

#sessionRetryCard {
    background-color: rgba(80, 20, 20, 0.7);
    border: 1px solid rgba(220, 53, 69, 0.3);
    border-radius: 8px;
}

#sessionRetryCard #retryMessage {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    border: none;
}

#sessionRetryCard #retryInfo {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

/* ============================================================
   ToolErrorCard (dark) — 工具错误详情卡片
   ============================================================ */

#toolErrorCard {
    background-color: rgba(80, 20, 20, 0.5);
    border: 1px solid rgba(220, 53, 69, 0.25);
    border-radius: 8px;
}

#toolErrorHeader {
    background: transparent;
    border: none;
}

#toolErrorName {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    border: none;
    font-weight: 600;
}

#toolErrorSummary {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

#toolErrorContent {
    background: transparent;
    border-top: 1px solid rgba(220, 53, 69, 0.15);
}

#toolErrorDetail {
    color: rgba(255, 255, 255, 0.75);
    background: transparent;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 13px;
}

/* ============================================================
   ContextUsageIndicator (dark) — 上下文用量指示器
   ============================================================ */

#contextUsageIndicator {
    background: transparent;
    border: none;
}

#contextUsageLabel {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
}

/* ============================================================
   SessionReviewPanel (dark) — 多文件 diff 审阅面板
   ============================================================ */

#sessionReviewPanel {
    background: transparent;
    border: none;
}

#reviewStatsBar {
    background-color: rgba(255, 255, 255, 0.04);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

#reviewSummary {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
}

#reviewTotalStats {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
}

#reviewFileItem {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

#reviewFileHeader {
    background: transparent;
    border: none;
}

#reviewFileHeader:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

#reviewFileName {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
}

#reviewFileStats {
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
}

#reviewFileContent {
    background: transparent;
    border: none;
}


/* ============================================================
   DockSurface (dark) — Dock 面板基类
   ============================================================ */

#dockSurface,
#permissionDock,
#questionDock,
#followupDock,
#revertDock,
#todoDock {
    background-color: rgba(40, 40, 44, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 4px 0px;
}

#dockHeader {
    background: transparent;
    border: none;
    padding: 4px 0px;
}

#dockContent {
    background: transparent;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 4px 0px;
}

#dockChevron {
    background: transparent;
}

/* ============================================================
   PermissionDock (dark)
   ============================================================ */

#permissionDock {
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(40, 40, 44, 0.96);
}

#permissionTitle {
    color: rgba(255, 255, 255, 0.9);
    background: transparent;
}

#permissionDesc {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
}

#permissionPattern {
    color: rgba(255, 255, 255, 0.65);
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    padding: 2px 6px;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 12px;
}

/* ============================================================
   QuestionDock (dark)
   ============================================================ */

#questionTitle {
    color: rgba(255, 255, 255, 0.9);
    background: transparent;
}

/* ============================================================
   FollowupDock (dark)
   ============================================================ */

#followupSummary {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    font-weight: 500;
}

#followupPreview {
    color: rgba(255, 255, 255, 0.4);
    background: transparent;
}

#followupItemText {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
}

/* ============================================================
   RevertDock (dark)
   ============================================================ */

#revertSummary {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    font-weight: 500;
}

#revertPreview {
    color: rgba(255, 255, 255, 0.4);
    background: transparent;
}

#revertItemText {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
}

/* ============================================================
   TodoDock (dark)
   ============================================================ */

#todoProgress {
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
    font-weight: 600;
}

#todoPreview {
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

#todoItemIcon {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    font-size: 14px;
}

#todoItemText {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
}

/* ============================================================
   McpToolCard (dark) — MCP 工具调用卡片
   ============================================================ */

#mcpToolDesc {
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    border: none;
    font-style: italic;
}

/* ============================================================
   SkillCard (dark) — Skill/Plugin 调用卡片
   ============================================================ */

#skillDesc {
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
    border: none;
}

#skillParams {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 6px 10px;
}

#skillParamRow {
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Menlo", monospace;
    font-size: 12px;
}
